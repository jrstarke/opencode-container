{
  "$schema": "https://opencode.ai/config.json",
  "model": "tensorzero/tensorzero::function_name::app_dev_chat",
  "instructions": ["/workspace/.context/memory.md", "/home/appuser/.config/opencode/AGENTS.md"],
  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git"],
  "skills": {
    "paths": ["/home/appuser/.config/opencode/skills"]
  },
  "provider": {
    "tensorzero": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "TensorZero",
      "options": {
        "baseURL": "https://tensorzero.f00f.xyz/openai/v1"
      },
      "models": {
        "tensorzero::function_name::devops_chat": {
          "name": "DevOps"
        },
        "tensorzero::function_name::app_dev_chat": {
          "name": "App Dev"
        },
        "tensorzero::function_name::hard_logic_chat": {
          "name": "Hard Logic"
        },
        "tensorzero::function_name::log_analysis_chat": {
          "name": "Log Analysis"
        }
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny"
    },
    "bash": {
      "*": "allow"
    },
    "skill": {
      "*": "allow"
    },
    "edit": {
      "*/.config/opencode/*": "deny"
    },
    "external_directory": {
      "*/workspace/**": "allow"
    }
  }
}